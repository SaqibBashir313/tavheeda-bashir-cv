{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Use the workspace TypeScript, so the editor and `npm run typecheck` agree.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",

  // Tailwind v4 is CSS-first: point IntelliSense at the stylesheet that owns
  // the theme, and teach it about our class-name helpers.
  "tailwindCSS.experimental.configFile": "src/styles/globals.css",
  "tailwindCSS.classFunctions": ["cn", "cva", "clsx", "twMerge"],
  "css.customData": [],
  "files.associations": {
    "*.css": "tailwindcss"
  },

  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true,
    "**/package-lock.json": true
  }
}
