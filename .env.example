# Copy to `.env.local` and fill in. Only `VITE_`-prefixed vars reach the client bundle.
# Never put secrets here — everything in this file ships to the browser.

VITE_APP_NAME="Tavheeda Bashir"
VITE_API_BASE_URL="https://api.example.com/v1"
VITE_API_TIMEOUT_MS="12000"

# Feature flags — parsed as booleans by `src/config/env.ts`
VITE_ENABLE_MOCK_API="false"
VITE_ENABLE_ANALYTICS="false"
